# Copy to .env for local use (never commit the real values).
# Leave the Supabase values empty to use in-memory storage while developing.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
ADMIN_KEY=
# Optional: the Supabase *publishable/anon* key (safe to expose). Enables instant live updates via Supabase Realtime;
# without it the game falls back to fast polling.
SUPABASE_ANON_KEY=
# Optional: email password reset links. Without an email service, players recover their account with a
# recovery code or an admin-issued link. Either send through a mailbox over SMTP (Gmail by default; SMTP_PASS
# is a Google app password, not your normal password)...
SMTP_USER=you@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ...or through Resend (https://resend.com), which needs a domain you own:
RESEND_API_KEY=
# Sender shown on the emails (required for Resend; defaults to "Chess <SMTP_USER>" for SMTP)
MAIL_FROM=
# Optional: public address used in emailed links (defaults to the Vercel production URL)
APP_URL=

# The Damage Report commentary. Without a key the funny lines come from a built-in bank of templates.
ANTHROPIC_API_KEY=
# Optional: model for the commentary (default claude-haiku-5-5), "off" in DAMAGE_LLM turns the AI off
DAMAGE_MODEL=
DAMAGE_LLM=
# Optional: milliseconds of engine work per request (default 5000 on Vercel, 30000 locally; the rest resumes on the next request)
DAMAGE_BUDGET_MS=
