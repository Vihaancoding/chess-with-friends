{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    },
    "api/fairplay.js": {
      "maxDuration": 60,
      "includeFiles": "public/stockfish/**"
    }
  },
  "rewrites": [
    {
      "source": "/d/:id",
      "destination": "/api?r=damage_page&p=:id"
    }
  ],
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/piece/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
